PROJECT_NAME="CueSpace"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="cuespace-ultra-secure-random-secret-key-change-in-production"

# PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="cuespace_db"
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/cuespace_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Notification Provider Credentials
RESEND_API_KEY="re_test_123456789"
EMAILS_FROM_EMAIL="notifications@cuespace.app"
EMAILS_FROM_NAME="CueSpace Reminders"

TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Front-end Base URL (for 1-click snooze and action redirect links)
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
